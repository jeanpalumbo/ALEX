# Copy to .env and fill in. .env is gitignored — never commit real secrets.

# === Profile: offline (default, no real external calls) | sandbox | live ===
PROFILE=offline

# === Console auth token — auto-generated into .env on first run if empty ===
CONSOLE_TOKEN=

# === Approvals ===
APPROVAL_TTL_SECONDS=1800

# === AI CEO model (required for the chat to work) ===
ANTHROPIC_API_KEY=sk-ant-XXXXXXXXXXXXXX
CEO_MODEL=claude-sonnet-5

# === Free-tier background model (optional) -- ONLY for autonomous persona ===
# === check-ins, never for real interactive reasoning. Create a free      ===
# === account at openrouter.ai to get a key. Leave empty to disable --    ===
# === autonomous check-ins then report blocked instead of silently        ===
# === billing the paid model.                                             ===
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# === Shopify (optional — ShopifyAgent stays BLOCKED without these) ===
SHOPIFY_STORE=tu-tienda.myshopify.com
SHOPIFY_TOKEN=shpat_XXXXXXXXXXXXXX
SHOPIFY_API_VERSION=2024-10

# === Autonomy (off by default — costs real money per tick when enabled) ===
AUTONOMOUS_LLM_TICKS=false
AUTONOMOUS_TICK_INTERVAL_SECONDS=3600
AUTONOMOUS_TICK_ESTIMATED_COST=0.05

# === Web server ===
CEO_CONSOLE_HOST=127.0.0.1
CEO_CONSOLE_PORT=8420

# === Budgets ===
DAILY_BUDGET_LIMIT=20.0
SHOPIFY_BUDGET_LIMIT=10.0
CEO_LLM_BUDGET_LIMIT=5.0
ENGINEERING_BUDGET_LIMIT=0.0
RESEARCH_BUDGET_LIMIT=5.0
STORE_OPS_BUDGET_LIMIT=5.0
ENGINEERING_LEAD_BUDGET_LIMIT=5.0

# === Telegram bridge (optional) — talk to the CEO from anywhere, no shared ===
# === network/VPN needed. Leave empty to disable.                          ===
# 1. In Telegram, message @BotFather -> /newbot -> paste the token below.
# 2. Restart, then message your bot anything -- it replies with your chat_id.
# 3. Paste that chat_id below and restart again to lock the bridge to you.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_ID=
